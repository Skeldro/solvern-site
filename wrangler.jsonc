{
  // Lets Cloudflare's Workers flow deploy this as a static site: `npx wrangler
  // deploy` uploads this directory minus .assetsignore's list (index.html,
  // _headers, robots.txt) and honours _headers. The Pages flow ignores this file;
  // its build output directory is "/".
  "name": "solvern-site",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./" }
}
